# Trading Controls
TRADING_ENABLED=false
ACCOUNT_MODE=paper

# Data Sources
FINNHUB_API_KEY=your_key_here

# Database
DATABASE_URL=sqlite:///./data/tracker.db

# Interactive Brokers
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Position Limits
MAX_POSITION_PCT=0.08
MAX_DAILY_EXPOSURE_PCT=0.05
MAX_POSITIONS=15
MIN_POSITION_SIZE=500

# Exit Rules
MAX_HOLD_DAYS=30
PROFIT_TARGET_PCT=0.20
STOP_LOSS_PCT=0.10

# Notifications (Optional)
EMAIL_ENABLED=false
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# Logging
LOG_LEVEL=INFO
