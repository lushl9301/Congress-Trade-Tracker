# Congress Trade Tracker Configuration
# Copy this file to .env and fill in your values

# ============================================================
# DATA SOURCES (NEW: Multi-Source Support)
# ============================================================

# House Stock Watcher (FREE - No API key required)
# Provides House of Representatives trade disclosures
HSW_ENABLED=true

# Financial Modeling Prep (FREE tier: 250 requests/day)
# Provides Senate trade disclosures
# TODO: Get API key from https://financialmodelingprep.com/register
FMP_ENABLED=false
FMP_API_KEY=DUMMY_FMP_API_KEY_REPLACE_ME

# Multi-Source Strategy
# Options: primary_only, fallback, all, verify
# Recommended: verify (cross-verification for data quality)
DATA_SOURCE_STRATEGY=verify

# Finnhub API (DEPRECATED - requires PAID tier ~$50/month for congressional data)
# Kept for backwards compatibility, but NOT recommended for congressional trades
# FINNHUB_API_KEY=your_finnhub_api_key_here

# ============================================================
# IBKR Settings
# ============================================================
IBKR_HOST=127.0.0.1
# Paper Trading Ports:
#   TWS Paper: 7497
#   IB Gateway Paper: 4001
# Live Trading Ports:
#   TWS Live: 7496
#   IB Gateway Live: 4000
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# ============================================================
# Trading Controls (IMPORTANT!)
# ============================================================
# Trading mode: "paper" or "live"
TRADING_MODE=paper

# Enable/disable actual order submission
# CRITICAL: Set to "false" for testing
TRADING_ENABLED=false

# ============================================================
# Database
# ============================================================
DB_PATH=./data/app.db

# ============================================================
# Strategy Parameters (Optional - defaults in config.py)
# ============================================================
# MAX_DELAY_DAYS=14
# MIN_AMOUNT_HIGH=5000
# TARGET_PCT_STRONG=0.03
# TARGET_PCT_NORMAL=0.015
# MAX_TICKER_PCT=0.05
# MAX_DAILY_EXPOSURE=0.10
# MAX_HOLD_DAYS=30
# STOP_LOSS_PCT=-0.08
# TAKE_PROFIT_PCT=0.20

# ============================================================
# Email Notifications (Optional)
# ============================================================
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@example.com

# ============================================================
# Logging
# ============================================================
# Set in CLI via --log-level flag
# LOG_LEVEL=INFO
